# Demo / sandbox mode. "true" enables demo admin accounts, the shared sandbox
# password, in-memory fallbacks and synthetic gateway orders.
# MUST be unset or "false" on a real production deployment.
DEMO_MODE="false"
NEXT_PUBLIC_DEMO_MODE="false"

# Server & Database Configuration
DATABASE_URL="postgresql://user:password@localhost:5432/jewellery_db?schema=public"
NODE_ENV="development"
PORT="3000"

# Application Base URL
NEXT_PUBLIC_APP_URL="http://localhost:3000"

# Admin Authentication & Sessions
AUTH_SECRET="replace-with-a-random-32-character-secret-in-production"
ADMIN_SESSION_TTL_HOURS="24"

# Store Settings & High Value Consultation Logic
NEXT_PUBLIC_STORE_NAME="Chudiwalas"
NEXT_PUBLIC_WHATSAPP_NUMBER="919876543210"
# High value threshold in integer paise (₹1,00,000 = 10,000,000 paise)
HIGH_VALUE_THRESHOLD_PAISE="10000000"
GST_PERCENTAGE="3.0"

# Hosted Payment Gateway (Razorpay Sandbox)
RAZORPAY_KEY_ID="rzp_test_placeholderKeyId"
RAZORPAY_KEY_SECRET="placeholderKeySecret"
RAZORPAY_WEBHOOK_SECRET="placeholderWebhookSecret"

# Transactional Email (Resend / SMTP)
SMTP_HOST="smtp.example.com"
SMTP_PORT="587"
SMTP_USER="notification@example.com"
SMTP_PASS="placeholderSmtpPassword"
FROM_EMAIL="concierge@chudiwalas.com"

# Image Storage — Cloudinary (preferred on Vercel; free tier is enough to start)
# Dashboard > Settings > API Keys. Cloud name is the one in your Cloudinary URL.
# When these three are set they take priority over the STORAGE_* block below.
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
# Top-level folder every upload is nested under (default: chudiwalas)
CLOUDINARY_FOLDER="chudiwalas"

# Image Storage — S3 / R2 alternative (ignored when CLOUDINARY_* is set)
STORAGE_ENDPOINT="https://s3.amazonaws.com"
STORAGE_BUCKET="chudiwalas-assets"
STORAGE_ACCESS_KEY="placeholderAccessKey"
STORAGE_SECRET_KEY=
# Region for S3 ("ap-south-1") or "auto" for Cloudflare R2
STORAGE_REGION=
# Public base URL that serves the bucket, e.g. https://cdn.chudiwalas.com or https://<bucket>.s3.ap-south-1.amazonaws.com
STORAGE_PUBLIC_URL=
# When STORAGE_* are empty, uploads are written to ./uploads (or UPLOAD_DIR) and served at /uploads (dev / single VPS only)
UPLOAD_DIR=""

