datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

generator client {
  provider = "prisma-client-js"
}

enum Role {
  OWNER
  MANAGER
  STAFF
}

enum PriceVisibility {
  PUBLIC
  ON_REQUEST
}

enum OrderStatus {
  PENDING
  CONFIRMED
  CANCELLED
  RECONCILIATION_REQUIRED
}

enum PaymentStatus {
  PENDING
  AUTHORIZED
  PAID
  FAILED
  CANCELLED
  REFUNDED_RECORDED
}

enum FulfilmentStatus {
  UNFULFILLED
  PROCESSING
  SHIPPED
  DELIVERED
  CANCELLED
}

enum ReservationStatus {
  ACTIVE
  COMMITTED
  RELEASED
  EXPIRED
}

enum EnquiryType {
  CALLBACK
  WHATSAPP_INTENT
  APPOINTMENT
}

enum EnquiryStatus {
  NEW
  CONTACTED
  SCHEDULED
  CLOSED_CONVERTED
  CLOSED_LOST
}

model Product {
  id                 String              @id @default(cuid())
  slug               String              @unique
  skuGroup           String              @unique
  title              String
  description        String
  craftsmanshipNotes String?
  materialSummary    String              // e.g. "18K Yellow Gold with Natural Rose-Cut Diamonds"
  stoneDetails       String?             // e.g. "VS-GH Natural Diamonds, 1.45 ct tw"
  certificationData  String?             // e.g. "BIS Hallmarked & SGL Certified"
  isEnquiryOnly      Boolean             @default(false)
  priceVisibility    PriceVisibility     @default(PUBLIC)
  forceWhatsApp      Boolean             @default(false)
  isArchived         Boolean             @default(false)

  // Merchandising (homepage / listing badges, category filter)
  category           String?             // chokers | necklaces | earrings | rings | bracelets | bangles | mangalsutra
  isNewArrival       Boolean             @default(false)
  isBestSeller       Boolean             @default(false)
  styleId            String?             // Internal design reference shown on the product sheet

  // Product sheet (spec table). Carats/grams are stored as decimals, never money.
  stylingTip         String?
  dimensions         String?             // e.g. "27.3 (l) x 103.4 (w) mm"
  diamondWeightCts   Float?
  diamondQuality     String?             // e.g. "SI / GH"
  polkiWeightCts     Float?
  polkiCount         Int?
  otherStones        String?             // e.g. "Ruby 0.01 ct, Tourmaline 0.25 ct"
  grossWeightGrams   Float?

  createdAt          DateTime            @default(now())
  updatedAt          DateTime            @updatedAt

  variants           Variant[]
  media              ProductMedia[]
  collections        ProductCollection[]
  leads              EnquiryLead[]
  appointments       AppointmentRequest[]

  @@index([slug])
  @@index([skuGroup])
  @@index([isArchived])
}

model Variant {
  id                String                 @id @default(cuid())
  productId         String
  product           Product                @relation(fields: [productId], references: [id], onDelete: Cascade)
  sku               String                 @unique
  metalType         String                 // e.g. "18K Yellow Gold", "Platinum"
  size              String?                // e.g. "Ring Size 14"
  purity            String?                // e.g. "750 / 18K"
  metalColour       String?                // "Yellow Gold" | "Rose Gold" | "White Gold" | "Platinum"
  pricePaise        BigInt?                // null when price is ON_REQUEST
  compareAtPricePaise BigInt?              // Regular price shown struck through when an offer applies
  offerLabel        String?                // e.g. "50% off on making charges"
  // Indicative price breakup (paise). Redacted on the public DTO when ON_REQUEST.
  goldValuePaise    BigInt?
  stoneValuePaise   BigInt?
  makingChargesPaise BigInt?
  makingDiscountPercent Int?
  goldWeightGrams   Float?
  currency          String                 @default("INR")
  stockQuantity     Int                    @default(0)
  reservedQuantity  Int                    @default(0) // Virtual counter, validated atomically
  leadTimeDays      Int                    @default(14)
  isMadeToOrder     Boolean                @default(false)
  isPurchaseEnabled Boolean                @default(true)
  isArchived        Boolean                @default(false)
  createdAt         DateTime               @default(now())
  updatedAt         DateTime               @updatedAt

  reservations      InventoryReservation[]
  orderItems        OrderItem[]

  @@index([productId])
  @@index([sku])
}

model ProductMedia {
  id           String   @id @default(cuid())
  productId    String
  product      Product  @relation(fields: [productId], references: [id], onDelete: Cascade)
  url          String
  altText      String
  displayOrder Int      @default(0)
  isPrimary    Boolean  @default(false)
  isHoverImage Boolean  @default(false)
  variantId    String?  // Optional: show this photo when the matching variant is selected
  width        Int?
  height       Int?
  createdAt    DateTime @default(now())

  @@index([productId, displayOrder])
  @@index([variantId])
}

model Collection {
  id             String              @id @default(cuid())
  slug           String              @unique
  title          String
  description    String?
  bannerImageUrl String?
  displayOrder   Int                 @default(0)
  isArchived     Boolean             @default(false)
  createdAt      DateTime            @default(now())
  updatedAt      DateTime            @updatedAt

  products       ProductCollection[]

  @@index([slug])
}

model ProductCollection {
  productId    String
  collectionId String
  product      Product    @relation(fields: [productId], references: [id], onDelete: Cascade)
  collection   Collection @relation(fields: [collectionId], references: [id], onDelete: Cascade)

  @@id([productId, collectionId])
}

model InventoryReservation {
  id        String            @id @default(cuid())
  variantId String
  variant   Variant           @relation(fields: [variantId], references: [id])
  orderId   String?
  order     Order?            @relation(fields: [orderId], references: [id])
  quantity  Int
  status    ReservationStatus @default(ACTIVE)
  expiresAt DateTime
  createdAt DateTime          @default(now())
  updatedAt DateTime          @updatedAt

  @@index([variantId, status, expiresAt])
}

model Order {
  id               String            @id @default(cuid())
  orderNumber      String            @unique // Human readable: e.g. "ORD-2026-1001"
  capabilityToken  String            @unique @default(uuid()) // Opaque secure token for guest lookup
  customerName     String
  customerEmail    String
  customerPhone    String
  shippingAddress  Json              // Immutable snapshot of address object
  billingAddress   Json?

  currency         String            @default("INR")
  subtotalPaise    BigInt
  taxPaise         BigInt            // GST calculated server-side
  shippingPaise    BigInt            // Insured shipping charge
  totalPaise       BigInt            // subtotal + tax + shipping

  orderStatus      OrderStatus       @default(PENDING)
  paymentStatus    PaymentStatus     @default(PENDING)
  fulfilmentStatus FulfilmentStatus  @default(UNFULFILLED)

  paymentGateway   String            @default("RAZORPAY")
  gatewayOrderId   String?           @unique
  gatewayPaymentId String?

  trackingNumber   String?
  carrierName      String?
  adminNotes       String?

  createdAt        DateTime          @default(now())
  updatedAt        DateTime          @updatedAt

  items            OrderItem[]
  reservations     InventoryReservation[]
  paymentEvents    PaymentEvent[]

  @@index([orderNumber])
  @@index([capabilityToken])
  @@index([gatewayOrderId])
}

model OrderItem {
  id                String   @id @default(cuid())
  orderId           String
  order             Order    @relation(fields: [orderId], references: [id], onDelete: Cascade)
  variantId         String
  variant           Variant  @relation(fields: [variantId], references: [id])

  sku               String
  productTitle      String
  variantAttributes Json     // Snapshot of size, metal, purity
  unitPricePaise    BigInt   // Immutable snapshot at purchase time
  quantity          Int
  lineTotalPaise    BigInt   // unitPricePaise * quantity

  createdAt         DateTime @default(now())

  @@index([orderId])
}

model PaymentEvent {
  id                String   @id @default(cuid())
  orderId           String
  order             Order    @relation(fields: [orderId], references: [id], onDelete: Cascade)
  eventId           String   @unique // Webhook durable event ID
  eventType         String   // e.g. "payment.captured", "payment.failed"
  payload           Json
  signatureVerified Boolean  @default(false)
  processedAt       DateTime @default(now())

  @@index([orderId])
  @@index([eventId])
}

enum EnquiryLeadType {
  CALLBACK
  WHATSAPP_INTENT
  APPOINTMENT
}

model EnquiryLead {
  id               String        @id @default(cuid())
  type             EnquiryType
  customerName     String
  customerPhone    String
  customerEmail    String?
  preferredTime    String?
  message          String?
  productId        String?
  product          Product?      @relation(fields: [productId], references: [id])
  variantSku       String?
  consentToContact Boolean       @default(true)
  sourceUrl        String?
  status           EnquiryStatus @default(NEW)
  staffNotes       String?
  createdAt        DateTime      @default(now())
  updatedAt        DateTime      @updatedAt

  @@index([status])
  @@index([createdAt])
}

model AppointmentRequest {
  id                 String        @id @default(cuid())
  customerName       String
  customerPhone      String
  customerEmail      String
  requestedDate      DateTime
  requestedTimeSlot  String        // e.g. "11:00 AM - 01:00 PM"
  locationPreference String        // "IN_STORE" | "VIRTUAL"
  productId          String?
  product            Product?      @relation(fields: [productId], references: [id])
  status             EnquiryStatus @default(NEW)
  staffNotes         String?
  createdAt          DateTime      @default(now())
  updatedAt          DateTime      @updatedAt

  @@index([status])
}

model AdminUser {
  id           String     @id @default(cuid())
  email        String     @unique
  passwordHash String
  name         String
  role         Role       @default(STAFF)
  isActive     Boolean    @default(true)
  createdAt    DateTime   @default(now())
  updatedAt    DateTime   @updatedAt

  auditLogs    AuditLog[]
}

model StoreSettings {
  id                      String   @id @default("default")
  storeName               String   @default("Chudiwalas")
  whatsappNumber          String   @default("919876543210") // International digits only
  highValueThresholdPaise BigInt   @default(10000000) // ₹1,00,000 (10000000 paise)
  gstPercentage           Decimal  @default(3.0) // 3% GST on precious jewellery
  enablePurchases         Boolean  @default(true)
  contactEmail            String   @default("concierge@chudiwalas.com")
  updatedAt               DateTime @updatedAt
}

model Offer {
  id           String   @id @default(cuid())
  title        String   // "Min. 30% off on making charges"
  description  String?  // "Auto applied at checkout"
  code         String?  // Coupon code to show; null when auto-applied
  isAuto       Boolean  @default(true)
  isActive     Boolean  @default(true)
  displayOrder Int      @default(0)
  startsAt     DateTime?
  endsAt       DateTime?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  @@index([isActive, displayOrder])
}

model AuditLog {
  id         String     @id @default(cuid())
  userId     String?
  user       AdminUser? @relation(fields: [userId], references: [id])
  action     String     // "PRICE_UPDATE", "STOCK_ADJUST", "STATUS_CHANGE"
  entityType String     // "Product", "Variant", "Order", "Settings"
  entityId   String
  details    Json
  ipAddress  String?
  createdAt  DateTime   @default(now())

  @@index([entityType, entityId])
  @@index([createdAt])
}

